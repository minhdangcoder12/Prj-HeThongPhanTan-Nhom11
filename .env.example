# Copy to .env (gitignored) before `docker compose up`. Never commit real values.
POSTGRES_USER=rideflow_admin
POSTGRES_PASSWORD=change_me_local
RABBITMQ_USERNAME=rideflow
RABBITMQ_PASSWORD=change_me_local
# HMAC secret for JWT (Phase 1). >= 32 chars.
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min
# `demo` enables chaos/replay endpoints. Use `default` to hide them.
SPRING_PROFILES_ACTIVE=demo
